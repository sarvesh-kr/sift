{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sift",
  "version": "0.4.0",
  "identifier": "app.sift.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sift \u2014 Your space, simplified.",
        "width": 1380,
        "height": 980,
        "minWidth": 900,
        "minHeight": 650,
        "backgroundColor": "#f6f8f6",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A little clarity for your digital space.",
    "category": "Utility",
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
